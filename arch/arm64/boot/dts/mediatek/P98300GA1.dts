&mt6363_vsram_modem {
	regulator-always-on;
};

/*Microtrust(TEEI) utos real driver*/

&utos {
	microtrust,real-drv = <1>;
};

&mtkheap_page_svp {
	status = "ok";
};

&mtkheap_page_wfd {
	status = "ok";
};

&mtkheap_region_svp {
	status = "ok";
};

&mtkheap_region_wfd {
	status = "ok";
};

&mtee_svp {
	mtee:MTEE {
		compatible = "mediatek,mtk_svp_on_tee_support";
	};
	svp:SecureVideoPath {
		compatible = "mediatek,mtk_sec_video_path_support";
	};
};

