&mt6368_vtp {
	regulator-boot-on;
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <3300000>;
};

/*+chklst-98554,fangzhihua.wt,add,20240338,add pinctrl to cs,irq,int*/
&pio {
	ctp_nt36532_pins_default: pins-default {
	};
	ctp_nt36532_spi_cs_high: nt36532_spi_cs_high {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO11__FUNC_SPI2_CLK>,
				<PINMUX_GPIO12__FUNC_SPI2_CSB>,
				<PINMUX_GPIO14__FUNC_SPI2_MO>,
				<PINMUX_GPIO13__FUNC_SPI2_MI>;
			drive-strength = <2>;
		};
	};
	ctp_nt36532_spi_cs_low: nt36532_spi_cs_low {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO12__FUNC_GPIO12>;
			output-low;
		};
	};
	ctp_nt36532_int_active: nt36532_int_active {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
			input-enable;
		};
	};
	ctp_nt36532_int_suspend: nt36532_int_suspend {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
			output-low;
		};
	};

	ctp_nt36532_reset_active: reset1-active {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO60__FUNC_GPIO60>;
			output-high;
		};
	};
	ctp_nt36532_reset_suspend: reset1-suspend {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO60__FUNC_GPIO60>;
			output-low;
		};
	};


/* +PERIDOT-12531,fangzhihua.wt,20240918,add to fix current is biger than that needed 1-2mA after screenoff then close keyboard */
	/*ctp_nt36532_1p8v_en_high:nt36532_1p8v_en_high{
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO63__FUNC_GPIO63>;
			output-high;
		};
	}*/
	ctp_nt36532_1p8v_en_low:nt36532_1p8v_en_low {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO63__FUNC_GPIO63>;
			output-low;
		};
	};
	/*ctp_nt36532_bias_n_en_high: nt36532_bias_n_en_high {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO186__FUNC_GPIO186>;
			output-high;
