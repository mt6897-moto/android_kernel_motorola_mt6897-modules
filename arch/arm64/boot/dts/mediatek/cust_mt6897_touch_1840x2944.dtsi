	ctp_nt36532_bias_n_en_low:nt36532_bias_n_en_low {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO186__FUNC_GPIO186>;
			output-low;
		};
	};
	/*ctp_nt36532_bias_p_en_high:nt36532_bias_p_en_high{
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO187__FUNC_GPIO187>;
			output-high;
		};
