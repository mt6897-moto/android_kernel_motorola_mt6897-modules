	ctp_nt36532_gpio184_low: nt36532_gpio184_low {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO184__FUNC_GPIO184>;
			output-low;
		};
	};
	ctp_nt36532_gpio184_high: nt36532_gpio184_high {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO184__FUNC_GPIO184>;
			input-enable;
		};
	};
